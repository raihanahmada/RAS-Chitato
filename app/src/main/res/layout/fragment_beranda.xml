<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar"
    tools:context=".beranda.BerandaFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Header hijau: Toolbar + sapaan username dari SharedPreferences -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_hijau"
                android:orientation="vertical"
                android:paddingBottom="28dp">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    style="@style/Toolbar.Sikuda.Hijau"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24dp">

                    <TextView
                        android:id="@+id/txtInisial"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_ikon_bulat"
                        android:backgroundTint="@color/kuning_muda"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:textColor="#92400E"
                        android:textSize="20sp"
                        tools:text="R" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/sapaan"
                            android:textColor="@color/putih_redup"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtUsername"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/poppins_bold"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            tools:text="raihan" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/desc_logo"
                        android:src="@drawable/ic_logo_sikuda" />
                </LinearLayout>

                <!-- Info status sesi login -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_kaca"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_cek"
                        app:tint="@color/hijau_daun" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/sesi_judul"
                            android:textColor="@color/white"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/sesi_isi"
                            android:textColor="@color/putih_redup"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Menu cepat: pindah ke menu lain di Bottom Navigation -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Kartu.Putih"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="-16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingVertical="16dp">

                    <LinearLayout
                        android:id="@+id/btnCepatTbs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_ikon_bulat"
                            android:backgroundTint="@color/oranye_muda"
                            android:importantForAccessibility="no"
                            android:padding="15dp"
                            android:src="@drawable/ic_nav_tbs"
                            app:tint="@color/oranye_tbs" />

                        <TextView
                            style="@style/Teks.Isi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/cepat_tbs"
                            android:textColor="@color/teks_gelap" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnCepatKartu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_ikon_bulat"
                            android:backgroundTint="@color/hijau_muda"
                            android:importantForAccessibility="no"
                            android:padding="15dp"
                            android:src="@drawable/ic_nav_kartu"
                            app:tint="@color/hijau_tua" />

                        <TextView
                            style="@style/Teks.Isi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/cepat_kartu"
                            android:textColor="@color/teks_gelap" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnCepatSimpanan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_ikon_bulat"
                            android:backgroundTint="@color/kuning_muda"
                            android:importantForAccessibility="no"
                            android:padding="15dp"
                            android:src="@drawable/ic_nav_simpanan"
                            app:tint="@color/kuning_dana" />

                        <TextView
                            style="@style/Teks.Isi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/cepat_simpanan"
                            android:textColor="@color/teks_gelap" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Harga TBS hari ini -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_ikon_bulat"
                android:backgroundTint="@color/oranye_muda"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_ikon_bulat"
                    android:backgroundTint="@color/oranye_tbs"
                    android:importantForAccessibility="no"
                    android:padding="13dp"
                    android:src="@drawable/ic_naik"
                    app:tint="@color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Teks.Isi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/beranda_harga_label" />

                    <TextView
                        style="@style/Teks.Judul"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/beranda_harga"
                        android:textSize="20sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:backgroundTint="@color/hijau_muda"
                    android:fontFamily="@font/poppins_bold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="@string/beranda_harga_naik"
                    android:textColor="@color/hijau_utama"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                style="@style/Teks.Judul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:text="@string/beranda_praktikum"
                android:textSize="16sp" />

            <!-- My Project: detail snack (SnackActivity) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnMyProject"
                style="@style/Kartu.Putih"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_ikon_bulat"
                        android:backgroundTint="@color/oranye_muda"
                        android:contentDescription="@string/desc_gambar"
                        android:padding="6dp"
                        android:src="@drawable/chitato" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Teks.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/menu_snack_judul"
                            android:textSize="15sp" />

                        <TextView
                            style="@style/Teks.Isi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/menu_snack_isi" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_kanan"
                        app:tint="@color/teks_abu" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
